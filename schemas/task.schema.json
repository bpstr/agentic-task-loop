{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-task-loop.local/schemas/task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "title", "description", "acceptanceCriteria", "constraints"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "source": { "enum": ["plain", "jira"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "externalReference": { "type": "string", "minLength": 1 }
  }
}
